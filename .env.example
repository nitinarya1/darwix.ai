# Apex Commercial AI Engineer Platform - Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL

# Server & Client Configuration
PORT=3000
NODE_ENV=production
VITE_APP_TITLE="Apex AI Engineer Production Platform"

# Knowledge Base & Embeddings (Optional Cloud Vector DB fallback)
VECTOR_DB_PROVIDER=in_memory_dense_rrf # options: in_memory_dense_rrf, qdrant, pinecone
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Speech & Voice Telephony Providers
ASR_PROVIDER=web_speech_api # options: web_speech_api, whisper_v3, google_chirp2
TTS_PROVIDER=web_speech_synthesis # options: web_speech_synthesis, elevenlabs, azure_neural
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
CALLABLE_INBOUND_PHONE_NUMBER="+18004122739"

# CRM & Webhook Escalation Endpoints
CRM_WEBHOOK_URL="https://api.apexlending.com/v1/crm/lead-ingest"
CRM_API_KEY="test_sandbox_crm_key_placeholder"

# Live Nudge Pipeline Telemetry
NUDGE_CONFIDENCE_THRESHOLD=0.75
NUDGE_COOLDOWN_SECONDS=30
ENABLE_AUDIO_NOISE_SUPPRESSION=true
